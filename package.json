    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
